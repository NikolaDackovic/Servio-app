DATABASE_URL="postgresql://pos:pos_dev@localhost:5432/pos"
# Najmanje 32 nasumična znaka (npr. openssl rand -hex 32)
JWT_SECRET="promeni-me-najmanje-32-nasumicna-znaka-xx"
# Promena ove vrednosti poništava sve PIN-ove
PIN_PEPPER="promeni-me"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
PAYMENT_MODE=TEST
# Samo za testove (baza mora da se završava na _test — testovi je brišu):
TEST_DATABASE_URL="postgresql://pos:pos_dev@localhost:5432/pos_test"
# Fiskalizacija: TEST = testni adapter (računi su jasno označeni kao TEST, NISU fiskalni), NONE = isključeno.
# Stvarna integracija sa PFR/ESIR ne postoji.
FISCAL_PROVIDER=TEST
FISCAL_WORKER_INTERVAL_MS=5000
