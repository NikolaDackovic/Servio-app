# Adresa POS API-ja (sa /api/v1)
API_URL=http://localhost:3000/api/v1
# Ključ izdaje ADMIN → Štampa → Print Bridge (prikazuje se samo jednom). Ne čuvati u git-u.
BRIDGE_KEY=
# Koliko često se proveravaju novi zadaci (ms)
POLL_MS=1500
# Kodiranje srpskih slova: ascii (š→s, đ→dj — uvek čitljivo), cp852 ili cp1250 (proveriti probnom stranom!)
CODEPAGE=ascii
# Broj kodne strane za komandu ESC t n — zavisi od modela štampača (Epson: PC852=18, WPC1250=45)
# CODEPAGE_NUMBER=18
# Gde SIMULATED štampač upisuje "odštampane" blokove (tekst)
SIMULATED_DIR=./simulated-output
